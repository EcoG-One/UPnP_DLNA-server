    function loadNext(){
        i++;
        var script = _scripts[i];
        if (script) {
            head.appendChild(script.element);
            if (script.isAsync) {
                loadNext();
            } else {
                script.load.then(loadNext);
            }
        }
    }

    loadNext();

})(["https://s.discogs.com/dst/javascripts/vendor.js?da6da", "https://s.discogs.com/dst/javascripts/discogs.js?183d5"]);
