                            slot.addService(googletag.pubads());
                        }
                        var mobileBanner = [320, 50];
                        var sizes = {
                            top: [[970, 90], [728, 90]],
                            bottom: [[970, 90], [728, 90]],
                            left: [160, 600],
                            right: [[336, 280], [300, 250]]
                        };
                        if (document.documentElement.className.match('is_mobile')) {
                            sizes.top.push(mobileBanner);
                            sizes.bottom.push(mobileBanner);
                        }
                        var mappings = {
                            top: googletag.sizeMapping().
                                addSize([980, 500], sizes.top[0]).
                                addSize([800, 500], sizes.top[1]).
                                addSize([0, 0], sizes.top[sizes.top.length - 1]).
                                build(),
                            bottom: googletag.sizeMapping().
                                addSize([980, 500], sizes.bottom[0]).
                                addSize([800, 500], sizes.bottom[1]).
                                addSize([0, 0], sizes.bottom[sizes.bottom.length - 1]).
                                build(),
                            right: googletag.sizeMapping().
                                addSize([1205, 500], sizes.right[0]).
                                addSize([0, 0], sizes.right[1]).
                                build()
                        };
                        _.each(sizes, makeSlot);

                        googletag.pubads();

                        if( 'pageObject' in dsdata ) {
                            if( 'genres' in dsdata['pageObject'] ){
                                googletag.pubads().setTargeting('Genre', dsdata['pageObject']['genres']);
                            }

                            if( 'styles' in dsdata['pageObject'] ){
                                googletag.pubads().setTargeting('EStyle', dsdata['pageObject']['styles']);
                            }
                            if( 'objectId' in dsdata['pageObject'] ) {
                                googletag.pubads().setTargeting('objectId', dsdata['pageObject']['objectId'].toString());
                            }

                            if( 'objectType' in dsdata['pageObject'] ) {
                                googletag.pubads().setTargeting('objectType', dsdata['pageObject']['objectType']);
                            }
                        }

                        if( 'searchQuery' in dsdata ){
                            googletag.pubads().setTargeting('searchQuery', dsdata['searchQuery']);
                        }


                        googletag.enableServices();
                    });
                });
            });
        }
    </script>

